# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (used in step 3 for payment confirmation emails)
RESEND_API_KEY=
EMAIL_FROM="Rollie <orders@rollietreats.sg>"
