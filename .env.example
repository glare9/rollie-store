# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the admin pages at /admin
ADMIN_PASSWORD=

# Resend, for payment confirmation emails
RESEND_API_KEY=
# Leave unset until your domain is verified in Resend; it then defaults to onboarding@resend.dev,
# which only delivers to your own Resend account email.
# EMAIL_FROM="Rollie <orders@rollietreats.sg>"
